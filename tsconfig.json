{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.ts",
    "providers/**/*.ts",
    "adapters/**/*.ts",
    "tests/plugin/core.test.ts",
    "tests/plugin/jev.test.ts"
  ]
}
